
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.practicahilosjavafx.ProcesadorController"
      alignment="CENTER"
      spacing="18"
      prefWidth="640"
      prefHeight="500">

    <padding>
        <Insets top="25" right="30"
                bottom="25" left="30"/>
    </padding>

    <Label text="Monitor de procesamiento empresarial"
           style="-fx-font-size: 21px; -fx-font-weight: bold;"/>

    <Label text="NicaData Solutions - Procesos concurrentes"/>

    <Separator/>

    <!-- PROCESAMIENTO DE CLIENTES -->
    <VBox spacing="10" alignment="CENTER_LEFT">

        <Label text="Clientes - 100 registros"
               style="-fx-font-size: 17px; -fx-font-weight: bold;"/>

        <Label fx:id="lblEstadoClientes"
               text="Esperando inicio"/>

        <ProgressBar fx:id="barraClientes"
                     progress="0"
                     prefWidth="540"
                     prefHeight="22"
                     minHeight="22"
                     maxWidth="Infinity"
                     style="-fx-accent: #2563eb;"/>

        <Label fx:id="lblPorcentajeClientes"
               text="0%"/>

        <HBox spacing="10">

            <Button fx:id="btnIniciarClientes"
                    text="Iniciar clientes"
                    onAction="#iniciarClientes"/>

            <Button fx:id="btnDetenerClientes"
                    text="Detener clientes"
                    onAction="#detenerClientes"
                    disable="true"/>

        </HBox>
    </VBox>

    <Separator/>

    <!-- PROCESAMIENTO DE PRODUCTOS -->
    <VBox spacing="10" alignment="CENTER_LEFT">

        <Label text="Productos - 50 registros"
               style="-fx-font-size: 17px; -fx-font-weight: bold;"/>

        <Label fx:id="lblEstadoProductos"
               text="Esperando inicio"/>

        <ProgressBar fx:id="barraProductos"
                     progress="0"
                     prefWidth="540"
                     prefHeight="22"
                     minHeight="22"
                     maxWidth="Infinity"
                     style="-fx-accent: #16a34a;"/>

        <Label fx:id="lblPorcentajeProductos"
               text="0%"/>

        <HBox spacing="10">

            <Button fx:id="btnIniciarProductos"
                    text="Iniciar productos"
                    onAction="#iniciarProductos"/>

            <Button fx:id="btnDetenerProductos"
                    text="Detener productos"
                    onAction="#detenerProductos"
                    disable="true"/>

        </HBox>
    </VBox>

    <Separator/>

    <!-- CONTROLES GENERALES -->
    <HBox alignment="CENTER" spacing="15">

        <Button fx:id="btnIniciarAmbos"
                text="Iniciar ambos"
                onAction="#iniciarAmbos"/>

        <Button fx:id="btnReiniciarTodo"
                text="Reiniciar todo"
                onAction="#reiniciarTodo"/>

    </HBox>

</VBox>
